# 应用配置
NODE_ENV=development
PORT=3001

# 数据库配置
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=gmod_user
DB_PASSWORD=gmod_password
DB_DATABASE=gmod_manager

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Lq030522

# Session 配置
# 重要: 生产环境请使用随机生成的强密钥!
# 生成方法: openssl rand -base64 32
JWT_SECRET=UQL72zGaO2wrX6RIKNrVAwV8hBpJ207Q

# Docker 配置
DOCKER_SOCKET_PATH=/var/run/docker.sock
GMOD_IMAGE=hackebein/garrysmod:latest

# 文件路径配置 (Linux)
BARE_REPO_ROOT=/srv/bare
ALLCODE_ROOT=/srv/allcode
INSTANCES_ROOT=/srv/instances

# CORS 配置
# 多个来源用逗号分隔，例如: http://localhost:5173,https://example.com
# 允许全部来源可设置为 *
CORS_ORIGIN=*
