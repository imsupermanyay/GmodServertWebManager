# Server Configuration
PORT=3001
NODE_ENV=development

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=gmod_user
DB_PASSWORD=gmod_password
DB_DATABASE=gmod_manager
# MySQL Root 密码（用于自动创建数据库和用户，如果无权限可以留空）
DB_ROOT_PASSWORD=mysql_xd7pki

# JWT Configuration
JWT_SECRET=UQL72zGaO2wrX6RIKNrVAwV8hBpJ207Q
JWT_EXPIRATION=48h

# Docker Configuration
DOCKER_SOCKET_PATH=/var/run/docker.sock
# 额外 Docker 网络（逗号分隔），创建容器后自动连接，用于访问其他容器服务（如 1Panel 的 MySQL）
DOCKER_EXTRA_NETWORKS=1panel-network

# Super Admin Default Account
SUPER_ADMIN_USERNAME=novicepie
SUPER_ADMIN_PASSWORD=novicepie030522

# Frontend Configuration
FRONTEND_PORT=80

# CORS 配置 - 允许的前端地址
# 开发环境：使用 * 允许所有地址（方便测试）
ALLOWED_ORIGINS=*
# 生产环境：指定具体地址（安全）
# ALLOWED_ORIGINS=https://yourdomain.com,http://yourdomain.com
# 本地开发多地址示例:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173